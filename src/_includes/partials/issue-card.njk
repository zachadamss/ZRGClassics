<article class="issue-card{% if issue.difficulty %} difficulty-level-{{ issue.difficulty | lower }}{% endif %}" id="{{ issue.id }}">
    <div class="issue-header">
        <h3>{{ issue.title }}</h3>
        <div class="issue-header-tools">
            {% if issue.difficulty %}
            <span class="difficulty-badge difficulty-{{ issue.difficulty | lower }}">{{ issue.difficulty }}</span>
            {% endif %}
            <button type="button" class="copy-link-btn" data-copy-link="#{{ issue.id }}" aria-label="Copy a link to {{ issue.title }}">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"/></svg>
                <span class="copy-link-label" aria-live="polite">Copy link</span>
            </button>
        </div>
    </div>
    <p class="symptoms"><strong>Symptoms:</strong> {{ issue.symptoms }}</p>
    <p class="description">{{ issue.description }}</p>

    {% if issue.repairCosts %}
    <div class="repair-costs">
        <h4>Estimated Repair Costs</h4>
        <div class="cost-comparison">
            <div class="cost-item diy">
                <span class="cost-label">DIY</span>
                <span class="cost-value">{{ issue.repairCosts.diy | money }}</span>
            </div>
            <div class="cost-item shop">
                <span class="cost-label">Shop</span>
                <span class="cost-value">{{ issue.repairCosts.shop | money }}</span>
            </div>
        </div>
        {% if issue.repairCosts.notes %}
        <p class="cost-notes">{{ issue.repairCosts.notes }}</p>
        {% endif %}
    </div>
    {% endif %}

    <div class="fix">
        <h4>Common Fixes</h4>
        <ul>
            {% for fix in issue.fixes %}
            <li>{{ fix }}</li>
            {% endfor %}
        </ul>
    </div>

    {% if issue.parts and issue.parts.length > 0 %}
    <div class="parts-list">
        <h4>Common Parts</h4>
        <table class="parts-table">
            <thead>
                <tr>
                    <th>Part</th>
                    <th>Part Number</th>
                    <th>Typical price</th>
                </tr>
            </thead>
            <tbody>
                {% for part in issue.parts %}
                <tr>
                    <td data-label="Part">{{ part.name }}</td>
                    <td data-label="Part #" class="part-number">
                        {%- if part.partNumber %}{{ part.partNumber | partNumber(vehicleData.brand | lower) }}
                        {%- elif part.brand %}<span class="part-brand">{{ part.brand }}</span>
                        {%- else %}<span class="part-varies">Varies</span>{% endif -%}
                    </td>
                    <td data-label="Price" class="part-price">{{ part.price | money }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    {% if issue.relatedIssues and issue.relatedIssues.length > 0 %}
    <div class="related-issues">
        <h4>Same problem on other cars</h4>
        <div class="related-issues-list">
            {% for related in issue.relatedIssues %}
            <a href="/resources/{{ related.brand | lower }}/{{ related.vehicle }}/#{{ related.issueId }}" class="related-issue-link">
                <span class="related-brand">{{ related.brand }}</span>
                <span class="related-model">{{ related.model }}</span>
            </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if issue.sources %}
    <div class="attribution">
        <p>Sources:
            {% for source in issue.sources %}
            <a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.name }}</a>{% if not loop.last %}, {% endif %}
            {% endfor %}
        </p>
    </div>
    {% endif %}
</article>
