<!-- Skip Link for Accessibility -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- Header -->
<header class="site-header">
    <div class="logo">
        <a href="/" aria-label="ZRG Classics home">{% include "partials/logo.njk" %}</a>
    </div>
    <nav id="site-nav" aria-label="Main">
        <ul>
            {% for item in navigation.main %}
            {% set isCurrent = (item.url == "/" and page.url == "/") or (item.url != "/" and page.url.startsWith(item.url)) %}
            {% if item.children %}
            <li class="dropdown">
                <a href="{{ item.url }}" aria-haspopup="true"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a>
                <ul class="dropdown-menu">
                    {% for child in item.children %}
                    {% if child.brand %}
                    {#- Car submenus come from vehicleList so order and years match everywhere -#}
                    <li class="dropdown-item has-submenu">
                        <a href="{{ child.url }}">
                            {{ child.label }} <span class="submenu-arrow" aria-hidden="true">&#9656;</span>
                        </a>
                        <ul class="submenu">
                            {% for key in vehicleList[child.brand] %}{% set v = vehicles[key] %}
                            <li><a href="/resources/{{ child.brand }}/{{ key }}/">{{ v.fullName | replace(v.brand + " ", "") }} <span class="submenu-years">{{ v.years | range }}</span></a></li>
                            {% endfor %}
                        </ul>
                    </li>
                    {% else %}
                    <li><a href="{{ child.url }}">{{ child.label }}</a></li>
                    {% endif %}
                    {% endfor %}
                </ul>
            </li>
            {% else %}
            <li><a href="{{ item.url }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endif %}
            {% endfor %}
            <li class="nav-auth">
                <div class="auth-links">
                    <a href="/account/login/" class="nav-text-link">Sign in</a>
                    <a href="/account/register/" class="nav-pill">Join free</a>
                </div>
            </li>
        </ul>
    </nav>
    <div class="header-utils">
        <a href="/search/" class="icon-btn" aria-label="Search the site"{% if page.url == "/search/" %} aria-current="page"{% endif %}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
        <button id="theme-toggle" class="icon-btn theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false">
            <svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
            <svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
    </div>
    <button class="hamburger" id="hamburger-btn" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
    </button>
</header>
