{#- Full buyer's guide for one vehicle. Rendered on /resources/<brand>/<key>/buying/. -#}
{% set bg = vehicle.buyersGuide %}
<div class="buyers-guide">
    {% if bg %}

    <section id="overview" class="resource-section buyers-guide-overview">
        <h2 class="section-title">Overview</h2>
        <p class="buyers-guide-lede">{{ bg.overview | safe }}</p>

        {% if bg.quickFacts %}
        <dl class="quick-facts-grid">
            {% if bg.quickFacts.productionYears %}
            <div class="quick-fact"><dt class="fact-label">Production</dt><dd class="fact-value">{{ bg.quickFacts.productionYears | range }}</dd></div>
            {% endif %}
            {% if bg.quickFacts.totalProduced %}
            <div class="quick-fact"><dt class="fact-label">Built</dt><dd class="fact-value">{{ bg.quickFacts.totalProduced }}</dd></div>
            {% endif %}
            {% if bg.quickFacts.priceRange %}
            <div class="quick-fact"><dt class="fact-label">Price range</dt><dd class="fact-value">{{ bg.quickFacts.priceRange | range }}</dd></div>
            {% endif %}
            {% if bg.quickFacts.bestYears %}
            <div class="quick-fact"><dt class="fact-label">Best years</dt><dd class="fact-value">{{ bg.quickFacts.bestYears | range }}</dd></div>
            {% endif %}
        </dl>
        {% endif %}
    </section>

    {% if bg.pricingGuide %}
    <section id="pricing" class="resource-section buyers-guide-pricing">
        <h2 class="section-title">What to Pay</h2>
        <p class="pricing-disclaimer">
            {%- if bg.pricingGuide.asOf %}Prices checked {{ bg.pricingGuide.asOf }}. {% endif -%}
            Rough US market ranges. Location, history, and options move these a lot.
        </p>
        <div class="pricing-tiers">
            {% for tier in [["project", "Project"], ["driver", "Driver"], ["excellent", "Excellent"], ["concours", "Concours"]] %}
            {% set t = bg.pricingGuide[tier[0]] %}
            {% if t %}
            <div class="pricing-tier tier-{{ tier[0] }}">
                <h3>{{ tier[1] }}</h3>
                <span class="price-range">{{ t.price | range }}</span>
                <p>{{ t.description }}</p>
            </div>
            {% endif %}
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if bg.variants and bg.variants.length %}
    <section id="variants" class="resource-section buyers-guide-variants">
        <h2 class="section-title">Which One to Buy</h2>
        <div class="variants-list">
            {% for variant in bg.variants %}
            <article class="variant-card">
                <h3>{{ variant.name }}</h3>
                <p class="variant-years">{{ variant.years | range }}</p>
                <p class="variant-description">{{ variant.description }}</p>
                {% if variant.desirability %}
                <p class="variant-desirability">
                    <span class="desirability-label">Desirability</span>
                    <span class="desirability-rating desirability-{{ variant.desirability | lower }}">{{ variant.desirability }}</span>
                </p>
                {% endif %}
            </article>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if bg.redFlags and bg.redFlags.length %}
    <section id="red-flags" class="resource-section buyers-guide-red-flags">
        <h2 class="section-title">Walk Away If…</h2>
        <ul class="red-flags-list">
            {% for flag in bg.redFlags %}
            <li>{{ flag }}</li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}

    {% if bg.inspectionPoints and bg.inspectionPoints.length %}
    <section id="inspection" class="resource-section buyers-guide-inspection">
        <div class="inspection-header">
            <div>
                <h2 class="section-title">Pre-Purchase Inspection</h2>
                <p class="section-subtitle">What I'd check on any {{ vehicle.model }} before buying, with a rough cost if it's bad. Print it and take it with you.</p>
            </div>
            <button type="button" class="btn btn-secondary no-print" data-print>Print checklist</button>
        </div>
        <div class="inspection-categories">
            {% for category in bg.inspectionPoints %}
            <details class="inspection-category"{% if loop.first %} open{% endif %}>
                <summary>
                    <span class="inspection-category-name">{{ category.category }}</span>
                    <span class="inspection-category-count">{{ category.items | length }} checks</span>
                </summary>
                <ul class="inspection-list">
                    {% for item in category.items %}
                    <li>
                        <strong>{{ item.check }}</strong>
                        <span class="inspection-detail">{{ item.detail }}</span>
                        {% if item.costIfBad %}
                        <span class="inspection-cost">If bad: {{ item.costIfBad | range }}</span>
                        {% endif %}
                    </li>
                    {% endfor %}
                </ul>
            </details>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if bg.whatToLookFor and bg.whatToLookFor.length %}
    <section class="resource-section buyers-guide-positives">
        <h2 class="section-title">Worth Paying Extra For</h2>
        <ul class="positives-list">
            {% for item in bg.whatToLookFor %}
            <li>{{ item }}</li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}

    {% if bg.ownershipCosts %}
    <section id="ownership" class="resource-section buyers-guide-costs">
        <h2 class="section-title">Running Costs</h2>
        <dl class="costs-grid">
            {% for cost in [["insurance", "Insurance"], ["annualMaintenance", "Annual maintenance"], ["commonRepairs", "Common repairs"], ["fuel", "Fuel economy"]] %}
            {% if bg.ownershipCosts[cost[0]] %}
            <div class="cost-item">
                <dt class="cost-label">{{ cost[1] }}</dt>
                <dd class="cost-value">{{ bg.ownershipCosts[cost[0]] | range }}</dd>
            </div>
            {% endif %}
            {% endfor %}
        </dl>
    </section>
    {% endif %}

    {% if bg.expertTips and bg.expertTips.length %}
    <section class="resource-section buyers-guide-tips">
        <h2 class="section-title">Before You Buy</h2>
        <ul class="tips-list">
            {% for tip in bg.expertTips %}
            <li>{{ tip }}</li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}

    {% else %}
    <p class="no-guide-message">I haven't written the {{ vehicle.model }} buyer's guide yet.</p>
    {% endif %}
</div>
