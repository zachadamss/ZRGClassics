<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
    // Runs before first paint: swap no-js for js, and apply the saved or
    // system theme so dark-mode visitors don't get a white flash.
    (function () {
        var root = document.documentElement;
        root.classList.remove('no-js');
        root.classList.add('js');
        var theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        if (theme === 'dark') root.setAttribute('data-theme', 'dark');
    })();
    </script>

    {# Generate dynamic SEO data for vehicle pages #}
    {% if vehicle and vehicles[vehicle] %}
        {% set vehicleData = vehicles[vehicle] %}
        {#- Kept under ~160 characters so search results show all of it -#}
        {% set autoDescription = vehicleData.tagline + " Known " + vehicleData.model + " problems with repair costs, plus guides and torque specs." %}
        {% set autoImage = vehicleData.heroImage %}
    {% endif %}

    <!-- Primary Meta Tags -->
    <title>{{ title }} - {{ site.name }}</title>
    <meta name="title" content="{{ title }} - {{ site.name }}">
    <meta name="description" content="{{ description | default(autoDescription) | default(site.description) }}">
    <meta name="author" content="{{ site.author.name if vehicleData else site.name }}">
    <meta name="robots" content="{{ robots | default('index, follow') }}">
    {%- if canonical != false %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {%- endif %}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="{{ ogType or ('article' if vehicleData else 'website') }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:title" content="{{ ogTitle | default(title) }} - {{ site.name }}">
    <meta property="og:description" content="{{ ogDescription | default(description) | default(autoDescription) | default(site.description) }}">
    <meta property="og:image" content="{{ site.url }}{{ ogImage | default(autoImage) | default(site.defaultImage) }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="{{ site.locale }}">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ site.url }}{{ page.url }}">
    <meta name="twitter:title" content="{{ ogTitle | default(title) }} - {{ site.name }}">
    <meta name="twitter:description" content="{{ ogDescription | default(description) | default(autoDescription) | default(site.description) }}">
    <meta name="twitter:image" content="{{ site.url }}{{ ogImage | default(autoImage) | default(site.defaultImage) }}">
    {% if site.social.twitter and site.twitterHandle %}
    <meta name="twitter:site" content="{{ site.twitterHandle }}">
    {% endif %}

    <!-- Favicon -->
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/images/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
    <meta name="theme-color" content="#F5F2EC" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0E1A28" media="(prefers-color-scheme: dark)">

    <!-- Fonts (self-hosted; the two faces above the fold are preloaded) -->
    <link rel="preload" href="/fonts/archivo-variable.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin>

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/styles.css">

    <!-- JSON-LD Structured Data (values go through dump so they're valid JSON) -->
    {%- set author = { "@type": "Person", "name": site.author.name, "url": site.url + site.author.url, "jobTitle": site.author.jobTitle, "homeLocation": { "@type": "Place", "name": site.author.homeLocation } } %}
    {%- set publisher = { "@type": "Organization", "name": site.name, "url": site.url, "logo": { "@type": "ImageObject", "url": site.url + "/images/apple-touch-icon.png" } } %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ site.name | dump | safe }},
        "url": {{ site.url | dump | safe }},
        "logo": {{ (site.url + "/images/apple-touch-icon.png") | dump | safe }},
        "description": {{ site.description | dump | safe }},
        "founder": {{ author | dump | safe }},
        "sameAs": [
            {%- set comma = joiner(", ") -%}
            {%- if site.social.facebook %}{{ comma() }}{{ site.social.facebook | dump | safe }}{% endif -%}
            {%- if site.social.twitter %}{{ comma() }}{{ site.social.twitter | dump | safe }}{% endif -%}
            {%- if site.social.instagram %}{{ comma() }}{{ site.social.instagram | dump | safe }}{% endif -%}
        ]
    }
    </script>

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": {{ site.name | dump | safe }},
        "url": {{ site.url | dump | safe }},
        "description": {{ site.description | dump | safe }},
        "publisher": {{ publisher | dump | safe }}
    }
    </script>

    {% if breadcrumbs and breadcrumbs.length > 0 %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {%- for crumb in breadcrumbs %}
            {
                "@type": "ListItem",
                "position": {{ loop.index }},
                "name": {{ crumb.label | dump | safe }},
                "item": {{ (site.url + (crumb.url if crumb.url else page.url)) | dump | safe }}
            }{% if not loop.last %},{% endif %}
            {%- endfor %}
        ]
    }
    </script>
    {% endif %}

    {#- Vehicle pages and buyer's guides: an article about the car, written by the owner -#}
    {% if vehicleData %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": {{ (schemaType or "TechArticle") | dump | safe }},
        "headline": {{ title | dump | safe }},
        "description": {{ (description or autoDescription) | dump | safe }},
        "image": {{ (site.url + vehicleData.heroImage) | dump | safe }},
        "url": {{ (site.url + page.url) | dump | safe }},
        "mainEntityOfPage": {{ (site.url + page.url) | dump | safe }},
        {%- if vehicleData.lastReviewed %}
        "dateModified": {{ vehicleData.lastReviewed | dump | safe }},
        {%- endif %}
        "inLanguage": "en-US",
        "author": {{ author | dump | safe }},
        "publisher": {{ publisher | dump | safe }},
        "about": {
            "@type": "Car",
            "name": {{ vehicleData.fullName | dump | safe }},
            "brand": { "@type": "Brand", "name": {{ vehicleData.brand | dump | safe }} },
            "model": {{ vehicleData.model | dump | safe }}
        }
    }
    </script>
    {% endif %}

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VB5BSWLP41"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VB5BSWLP41');
    </script>
</head>
<body>
    {% include "partials/header.njk" %}

    <div id="main-content">
        {{ content | safe }}
    </div>

    {% include "partials/footer.njk" %}

    <script src="/script.js"></script>
    <!-- Supabase Auth (loads on all pages for nav state) -->
    <script src="https://unpkg.com/@supabase/supabase-js@2.117.1"></script>
    <script src="/js/supabase.js"></script>
    {% if extraScripts %}
    {% for script in extraScripts %}
    <script src="/{{ script }}"></script>
    {% endfor %}
    {% endif %}
</body>
</html>
