---
layout: layouts/base.njk
canonical: false
title: Thread
description: "A thread on the ZRG Classics forum, where classic BMW and Porsche owners ask about problems, parts, and builds."
extraScripts:
  - js/forum.js
  - js/pages/forum-thread.js
---

<main class="forum-page thread-page">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/forum/">Forums</a>
      <span class="separator">/</span>
      <a href="#" id="category-link">Loading...</a>
      <span class="separator">/</span>
      <span id="thread-title-crumb">Loading...</span>
    </nav>

    <article id="thread-content" class="thread-content">
      <div class="loading">Loading thread...</div>
    </article>

    <section id="replies-section" class="replies-section" hidden>
      <h2>Replies</h2>
      <div id="replies-list" class="replies-list"></div>
      <div id="replies-pagination" class="pagination"></div>
    </section>

    <p id="locked-notice" class="locked-notice" hidden>This thread is locked, so it's closed to new replies.</p>

    <section id="reply-form-section" class="reply-form-section" hidden>
      <h2>Post a reply</h2>
      <form id="reply-form" class="reply-form">
        <div class="form-group">
          <label for="reply-content" class="visually-hidden">Your reply</label>
          <textarea id="reply-content" name="content" required rows="6"
                    placeholder="Write your reply…"></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Post reply</button>
        </div>
      </form>
    </section>

    <div id="login-prompt" class="login-prompt" hidden>
      <p><a href="/account/login/">Sign in</a> or <a href="/account/register/">create an account</a> to reply to this thread.</p>
    </div>
  </div>
</main>
