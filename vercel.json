{
  "buildCommand": "npm run build:prod",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://skgtbjqjtwscwbanagrf.supabase.co wss://skgtbjqjtwscwbanagrf.supabase.co https://api.convertkit.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/js/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tools/invoice",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tools/invoice/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tools/maintenance-tracker",
      "destination": "/account/garage/maintenance/",
      "permanent": true
    },
    {
      "source": "/tools/maintenance-tracker/",
      "destination": "/account/garage/maintenance/",
      "permanent": true
    },
    {
      "source": "/tools/restoration-checklist",
      "destination": "/account/garage/restoration/",
      "permanent": true
    },
    {
      "source": "/tools/restoration-checklist/",
      "destination": "/account/garage/restoration/",
      "permanent": true
    },
    {
      "source": "/community/forums/",
      "destination": "/forum/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/forum/:category/:threadId/",
      "destination": "/forum/thread/"
    },
    {
      "source": "/forum/:category/",
      "destination": "/forum/category/"
    }
  ]
}
